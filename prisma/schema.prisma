// Meera's - The Beauty Saga :: Prisma schema
// SQLite for local development. Switch `url` to PostgreSQL for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ────────────────────────────────────────────────────────────────────────────
// IDENTITY & ACCESS
// ────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String    @map("password_hash")
  role          String    @default("CUSTOMER") // OWNER | ADMIN | MANAGER | RECEPTIONIST | STAFF | CUSTOMER
  isActive      Boolean   @default(true) @map("is_active")
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")

  customer      Customer?
  staff         Staff?
  sessions      Session[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([role])
  @@index([email])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model RolePermission {
  id         String   @id @default(cuid())
  role       String
  permission String
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([role, permission])
  @@index([role])
  @@map("role_permissions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  String?  // JSON string
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ────────────────────────────────────────────────────────────────────────────
// PEOPLE
// ────────────────────────────────────────────────────────────────────────────

model Customer {
  id            String    @id @default(cuid())
  userId        String    @unique @map("user_id")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  avatarUrl     String?   @map("avatar_url")
  dateOfBirth   DateTime? @map("date_of_birth")
  gender        String?
  address       String?
  city          String?
  notes         String?
  loyaltyPoints Int       @default(0) @map("loyalty_points")
  referralCode  String    @unique @default("") @map("referral_code")
  referredBy    String?   @map("referred_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  reviews       Review[]
  payments      Payment[]
  favourites     Favorite[]
  loyaltyTx     LoyaltyTransaction[]
  giftCards     GiftCard[]
  memberships   CustomerMembership[]
  invoices      Invoice[]

  @@index([firstName])
  @@index([loyaltyPoints])
  @@map("customers")
}

model Staff {
  id           String    @id @default(cuid())
  userId       String    @unique @map("user_id")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  jobTitle     String    @map("job_title")
  bio          String?
  avatarUrl    String?   @map("avatar_url")
  phone        String?
  commissionRate Float   @default(0) @map("commission_rate")
  isActive     Boolean   @default(true) @map("is_active")
  hiredAt      DateTime  @default(now()) @map("hired_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings     Booking[] @relation("BookingStaff")
  availability StaffAvailability[]
  schedules    StaffSchedule[]
  leaveRequests LeaveRequest[]
  serviceLinks StaffService[]
  assignments  BookingStaff[]

  @@map("staff")
}

// ────────────────────────────────────────────────────────────────────────────
// SERVICES & PACKAGES
// ────────────────────────────────────────────────────────────────────────────

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?   @map("image_url")
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")

  services    Service[]

  @@map("service_categories")
}

model Service {
  id           String   @id @default(cuid())
  categoryId   String   @map("category_id")
  name         String
  slug         String   @unique
  description  String?
  imageUrl     String?  @map("image_url")
  durationMin  Int      @map("duration_min")
  priceCents   Int      @map("price_cents")
  isActive     Boolean  @default(true) @map("is_active")
  isFeatured   Boolean  @default(false) @map("is_featured")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  addons       Addon[]
  bookings     Booking[]
  bookingItems BookingItem[]
  packageItems PackageItem[]
  staffLinks   StaffService[]
  favourites   Favorite[]

  @@index([categoryId])
  @@index([isActive])
  @@map("services")
}

model Addon {
  id          String  @id @default(cuid())
  serviceId   String  @map("service_id")
  name        String
  description String?
  priceCents  Int     @map("price_cents")
  durationMin Int     @default(0) @map("duration_min")
  isActive    Boolean @default(true) @map("is_active")

  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("addons")
}

model Package {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  category      String // BRIDAL | MAKEUP | HAIR | SKIN | COMBO | OCCASION | FESTIVAL | CUSTOM
  description   String?
  imageUrl      String?   @map("image_url")
  priceCents    Int       @map("price_cents")
  discountCents Int       @default(0) @map("discount_cents")
  durationMin   Int       @map("duration_min")
  validityDays  Int       @default(90) @map("validity_days")
  terms         String?
  isFeatured    Boolean   @default(false) @map("is_featured")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  items         PackageItem[]
  bookings      Booking[]
  favourites    Favorite[]

  @@index([category])
  @@index([isActive])
  @@map("packages")
}

model PackageItem {
  id         String  @id @default(cuid())
  packageId  String  @map("package_id")
  serviceId  String  @map("service_id")
  quantity   Int     @default(1)

  package    Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service    Service @relation(fields: [serviceId], references: [id])

  @@map("package_items")
}

// ────────────────────────────────────────────────────────────────────────────
// BOOKING ENGINE
// ────────────────────────────────────────────────────────────────────────────

model Booking {
  id            String   @id @default(cuid())
  bookingNumber String   @unique @default("") @map("booking_number")
  customerId    String   @map("customer_id")
  packageId     String?  @map("package_id")
  serviceId     String?  @map("service_id")
  staffId       String?  @map("staff_id")
  status        String   @default("PENDING")
  // PENDING | CONFIRMED | CHECKED_IN | IN_PROGRESS | COMPLETED | CANCELLED | RESCHEDULED | NO_SHOW
  startsAt      DateTime @map("starts_at")
  endsAt        DateTime @map("ends_at")
  durationMin   Int      @map("duration_min")
  subtotalCents Int      @map("subtotal_cents")
  discountCents Int      @default(0) @map("discount_cents")
  totalCents    Int      @map("total_cents")
  notes         String?
  internalNotes String?  @map("internal_notes")
  bufferMin     Int      @default(0) @map("buffer_min")
  bookedAt      DateTime @default(now()) @map("booked_at")
  cancelledAt   DateTime? @map("cancelled_at")
  completedAt   DateTime? @map("completed_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer      Customer @relation(fields: [customerId], references: [id])
  service       Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  package       Package? @relation(fields: [packageId], references: [id])
  staff         Staff?   @relation("BookingStaff", fields: [staffId], references: [id])
  items         BookingItem[]
  assignment    BookingStaff?
  payment       Payment?
  review        Review?

  @@index([customerId])
  @@index([staffId])
  @@index([status])
  @@index([startsAt])
  @@map("bookings")
}

model BookingItem {
  id         String  @id @default(cuid())
  bookingId  String  @map("booking_id")
  serviceId  String  @map("service_id")
  addonId    String? @map("addon_id")
  name       String
  quantity   Int     @default(1)
  priceCents Int     @map("price_cents")

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service    Service @relation(fields: [serviceId], references: [id])

  @@map("booking_items")
}

model BookingStaff {
  id        String @id @default(cuid())
  bookingId String @unique @map("booking_id")
  staffId   String @map("staff_id")

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff     Staff   @relation(fields: [staffId], references: [id])

  @@map("booking_staff")
}

model StaffAvailability {
  id        String  @id @default(cuid())
  staffId   String  @map("staff_id")
  dayOfWeek Int     @map("day_of_week") // 0=Sunday
  startTime String  @map("start_time")  // "09:00"
  endTime   String  @map("end_time")
  isOff     Boolean @default(false) @map("is_off")

  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, dayOfWeek])
  @@map("staff_availability")
}

model StaffSchedule {
  id        String    @id @default(cuid())
  staffId   String    @map("staff_id")
  date      DateTime  @map("date") // day only
  startTime String    @map("start_time")
  endTime   String    @map("end_time")
  isOff     Boolean   @default(false) @map("is_off")
  note      String?

  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@map("staff_schedules")
}

model LeaveRequest {
  id        String    @id @default(cuid())
  staffId   String    @map("staff_id")
  startDate DateTime  @map("start_date")
  endDate   DateTime  @map("end_date")
  reason    String?
  status    String    @default("PENDING") // PENDING | APPROVED | REJECTED
  createdAt DateTime  @default(now()) @map("created_at")
  decidedAt DateTime? @map("decided_at")

  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

model StaffService {
  id        String @id @default(cuid())
  staffId   String @map("staff_id")
  serviceId String @map("service_id")

  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
  @@map("staff_services")
}

model WaitingListEntry {
  id           String   @id @default(cuid())
  customerName String   @map("customer_name")
  phone        String
  serviceId    String?  @map("service_id")
  preferredDay String?  @map("preferred_day")
  note         String?
  status       String   @default("WAITING") // WAITING | OFFERED | BOOKED | EXPIRED
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("waiting_list")
}

// ────────────────────────────────────────────────────────────────────────────
// BUSINESS HOURS & HOLIDAYS
// ────────────────────────────────────────────────────────────────────────────

model BusinessSetting {
  id        String @id @default(cuid())
  key       String @unique
  value     String // JSON
  label     String?

  @@map("business_settings")
}

model Holiday {
  id        String   @id @default(cuid())
  name      String
  date      DateTime @map("date")
  isRecurring Boolean @default(false) @map("is_recurring")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("holidays")
}

// ────────────────────────────────────────────────────────────────────────────
// FINANCE
// ────────────────────────────────────────────────────────────────────────────

model Payment {
  id            String    @id @default(cuid())
  bookingId     String    @unique @map("booking_id")
  customerId    String    @map("customer_id")
  amountCents   Int       @map("amount_cents")
  method        String    // CASH | CARD | BANK_TRANSFER | ONLINE | GIFT_CARD | LOYALTY
  status        String    @default("PENDING") // PENDING | PAID | PARTIAL | REFUNDED | FAILED
  paidAt        DateTime? @map("paid_at")
  reference     String?
  createdAt     DateTime  @default(now()) @map("created_at")

  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer      Customer  @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@map("payments")
}

model Invoice {
  id          String   @id @default(cuid())
  invoiceNumber String @unique @default("") @map("invoice_number")
  customerId  String   @map("customer_id")
  bookingId   String?  @map("booking_id")
  amountCents Int      @map("amount_cents")
  taxCents    Int      @default(0) @map("tax_cents")
  totalCents  Int      @map("total_cents")
  status      String   @default("UNPAID") // UNPAID | PAID | VOID
  issuedAt    DateTime @default(now()) @map("issued_at")
  dueAt       DateTime? @map("due_at")

  customer    Customer @relation(fields: [customerId], references: [id])

  @@map("invoices")
}

// ────────────────────────────────────────────────────────────────────────────
// POS, INVENTORY & SUPPLIERS
// ────────────────────────────────────────────────────────────────────────────

model Product {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String
  category     String?
  brand        String?
  unit         String   @default("pcs")
  costCents    Int      @default(0) @map("cost_cents")
  priceCents   Int      @default(0) @map("price_cents")
  stockQty     Int      @default(0) @map("stock_qty")
  lowStockAt   Int      @default(5) @map("low_stock_at")
  isActive     Boolean  @default(true) @map("is_active")

  movements    StockMovement[]
  sales        PosSaleItem[]
  purchases    Purchase[]

  @@map("products")
}

model StockMovement {
  id         String   @id @default(cuid())
  productId  String   @map("product_id")
  type       String // PURCHASE | SALE | ADJUSTMENT | RETURN
  quantity   Int
  note       String?
  balanceAfter Int    @map("balance_after")
  createdAt  DateTime @default(now()) @map("created_at")

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true) @map("is_active")

  purchases Purchase[]

  @@map("suppliers")
}

model Purchase {
  id          String   @id @default(cuid())
  supplierId  String   @map("supplier_id")
  productId   String   @map("product_id")
  quantity    Int
  unitCostCents Int   @map("unit_cost_cents")
  totalCents  Int      @map("total_cents")
  purchasedAt DateTime @default(now()) @map("purchased_at")

  supplier    Supplier @relation(fields: [supplierId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])

  @@map("purchases")
}

model Expense {
  id          String   @id @default(cuid())
  category    String
  description String
  amountCents Int      @map("amount_cents")
  incurredAt  DateTime @default(now()) @map("incurred_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("expenses")
}

model PosSale {
  id          String   @id @default(cuid())
  receiptNumber String @unique @default("") @map("receipt_number")
  customerId  String?  @map("customer_id")
  staffId    String?  @map("staff_id")
  subtotalCents Int    @map("subtotal_cents")
  discountCents Int    @default(0) @map("discount_cents")
  totalCents  Int      @map("total_cents")
  paymentMethod String @map("payment_method")
  createdAt   DateTime @default(now()) @map("created_at")

  items       PosSaleItem[]

  @@map("pos_sales")
}

model PosSaleItem {
  id          String  @id @default(cuid())
  saleId      String  @map("sale_id")
  productId   String? @map("product_id")
  serviceName String? @map("service_name")
  name        String
  quantity    Int
  unitPriceCents Int  @map("unit_price_cents")

  sale        PosSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("pos_sale_items")
}

// ────────────────────────────────────────────────────────────────────────────
// MARKETING & LOYALTY
// ────────────────────────────────────────────────────────────────────────────

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  description String?
  type        String // PERCENT | FIXED
  value       Int
  minSpendCents Int     @default(0) @map("min_spend_cents")
  maxUses     Int?      @map("max_uses")
  usedCount   Int       @default(0) @map("used_count")
  startsAt    DateTime? @map("starts_at")
  endsAt      DateTime? @map("ends_at")
  isActive    Boolean   @default(true) @map("is_active")

  @@map("coupons")
}

model Membership {
  id          String  @id @default(cuid())
  name        String
  tier        String  @unique
  priceCents  Int     @map("price_cents")
  benefits    String?
  discountPct Int     @default(0) @map("discount_pct")

  customers   CustomerMembership[]

  @@map("memberships")
}

model CustomerMembership {
  id           String    @id @default(cuid())
  customerId   String    @map("customer_id")
  membershipId String    @map("membership_id")
  startsAt     DateTime  @default(now()) @map("starts_at")
  endsAt       DateTime? @map("ends_at")
  status       String    @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED

  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  membership   Membership @relation(fields: [membershipId], references: [id])

  @@map("customer_memberships")
}

model LoyaltyTransaction {
  id          String   @id @default(cuid())
  customerId  String   @map("customer_id")
  points      Int      // +earn / -redeem
  reason      String
  bookingId   String?  @map("booking_id")
  createdAt   DateTime @default(now()) @map("created_at")

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("loyalty_transactions")
}

model GiftCard {
  id          String    @id @default(cuid())
  code        String    @unique
  customerId  String?   @map("customer_id")
  balanceCents Int      @map("balance_cents")
  initialCents Int      @map("initial_cents")
  recipientName String? @map("recipient_name")
  recipientPhone String? @map("recipient_phone")
  message     String?
  expiresAt   DateTime? @map("expires_at")
  redeemedAt  DateTime? @map("redeemed_at")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@map("gift_cards")
}

model Referral {
  id          String   @id @default(cuid())
  referrerId  String   @map("referrer_id")
  referredEmail String @map("referred_email")
  status      String   @default("PENDING") // PENDING | COMPLETED
  rewardCents Int      @default(0) @map("reward_cents")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("referrals")
}

// ────────────────────────────────────────────────────────────────────────────
// CONTENT
// ────────────────────────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  bookingId  String   @unique @map("booking_id")
  rating     Int
  comment    String?
  isApproved Boolean  @default(false) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at")

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Favorite {
  id         String  @id @default(cuid())
  customerId String  @map("customer_id")
  serviceId  String? @map("service_id")
  packageId  String? @map("package_id")

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service    Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  package    Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([customerId, serviceId, packageId])
  @@map("favourites")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  type      String
  title     String
  message   String
  channel   String   @default("IN_APP") // IN_APP | EMAIL | WHATSAPP
  isRead    Boolean  @default(false) @map("is_read")
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model WebsiteContent {
  id        String   @id @default(cuid())
  page      String
  section   String
  key       String
  value     String?  // JSON or plain
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([page, section, key])
  @@map("website_content")
}

model GalleryImage {
  id        String  @id @default(cuid())
  src       String
  alt       String
  category  String
  beforeSrc String? @map("before_src")
  afterSrc  String? @map("after_src")
  sortOrder Int     @default(0) @map("sort_order")
  isVisible Boolean @default(true) @map("is_visible")

  @@map("gallery_images")
}

model TeamProfile {
  id        String  @id @default(cuid())
  staffId   String? @map("staff_id")
  name      String
  role      String
  bio       String?
  imageUrl  String? @map("image_url")
  sortOrder Int     @default(0) @map("sort_order")
  isVisible Boolean @default(true) @map("is_visible")

  @@map("team_profiles")
}

model Testimonial {
  id        String  @id @default(cuid())
  name      String
  rating    Int     @default(5)
  comment   String
  imageUrl  String? @map("image_url")
  isVisible Boolean @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("testimonials")
}

model FAQ {
  id        String  @id @default(cuid())
  question  String
  answer    String
  sortOrder Int     @default(0) @map("sort_order")
  isVisible Boolean @default(true) @map("is_visible")

  @@map("faqs")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model SupportTicket {
  id        String   @id @default(cuid())
  customerId String? @map("customer_id")
  subject   String
  message   String
  status    String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("support_tickets")
}
